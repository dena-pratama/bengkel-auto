# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.

# Supabase (self-host di Coolify lokal, lewat Kong)
NEXT_PUBLIC_SUPABASE_URL=http://supabase.localhost
# Coolify > Supabase > Environment Variables > SERVICE_SUPABASEANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Coolify > Supabase > Environment Variables > SERVICE_SUPABASESERVICE_KEY (server only!)
SUPABASE_SERVICE_ROLE_KEY=

# Koneksi Postgres langsung untuk migration (Supabase CLI).
# Publish port DB di Coolify (supabase-db > Make it publicly available, port 54322).
DATABASE_URL=postgresql://postgres:<SERVICE_PASSWORD_POSTGRES>@127.0.0.1:54322/postgres

TZ=Asia/Jakarta
