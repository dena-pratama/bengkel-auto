# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.

# Supabase (self-host di Coolify lokal, lewat Kong)
NEXT_PUBLIC_SUPABASE_URL=http://supabase.localhost
# Coolify > Supabase > Environment Variables > SERVICE_SUPABASEANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Coolify > Supabase > Environment Variables > SERVICE_SUPABASESERVICE_KEY (server only!)
SUPABASE_SERVICE_ROLE_KEY=

# URL Supabase dari sisi server saat app jalan di container Coolify (jaringan yang sama dengan Supabase).
# Kosongkan saat `npm run dev` di host.
SUPABASE_INTERNAL_URL=http://supabase-kong:8000

# Koneksi Postgres langsung untuk migration (Supabase CLI).
# Publish port DB di Coolify (supabase-db > Make it publicly available, port 54322).
DATABASE_URL=postgresql://postgres:<SERVICE_PASSWORD_POSTGRES>@127.0.0.1:54322/postgres

TZ=Asia/Jakarta

# AI Analyst "Tanya AI": isi kunci penyedia yang dipakai (opsional; cukup satu. Penyedia tanpa kunci tidak tampil di halaman /ai).
# Server MCP dan skor kesehatan tidak butuh kunci ini.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
